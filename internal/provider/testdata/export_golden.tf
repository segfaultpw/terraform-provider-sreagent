# Copied byte for byte (from the next line on) from the platform: apps/sre_core/test/support/fixtures/hcl_export/sreagent.tf at
# sre-agent master b7212138c (the merge of tf-v03-p2, after v0.489.0), the file its export test pins. It is the export of a
# platform whose provider floor is 0.3.0.
# SRE Agent configuration for organization "acme".
# Generated by GET /api/v1/config/export?format=hcl. Review it, then run
# terraform init and terraform plan: the plan should import every row and change nothing.
# This file describes the organization at the moment of export and is meant for adopting once.
# Applying it in place of a configuration that already manages these resources deletes whatever
# the file does not list. Read every plan for "0 to destroy".

terraform {
  required_version = ">= 1.12"
  required_providers {
    sreagent = {
      source  = "segfaultpw/sreagent"
      version = ">= 0.3.0"
    }
  }
}

provider "sreagent" {
  organization = "acme"
}

# Terraform only reads status_page_incidents, aws_external_id, request_signing, compliance_periods, code_detection_settings, effective_repo_settings and alert_follow_up_settings, so they are not in this file.

