# Rendered by the platform's own exporter, not written by hand: the configuration API's export (GET /api/v1/config/export?format=hcl,
# SreCore.MCP.HclExport.render/2 behind the real facade) at sre-agent master b7212138c (the merge of tf-v03-p2, after v0.489.0), for a seeded organization
# with the infrastructure suite: the default SLA policy, a digest with no channel, two marked classes (other:ssrf, other:xxe), the rule the
# platform seeds, a paging rule, an allow rule that ended (repository acme/web, detector aws_access_key), one that never ends, and a second
# rule on the same glob (vendor/**) for the slack_token detector, which keeps its own label because the detector is part of it.
# Kept from that file: the header comments and the terraform and provider blocks and the blocks and imports of the five security resources, verbatim.
# Rewritten: the organization slug to acme and the random ids, to 00000000-0000-4000-8000-0000000000NN in file order (11 the seeded rule, 12 the
# paging rule, 13 the ended allow rule, 14 the open one, 15 the slack_token one), so the file does not change on every render.
# internal/provider/export_security_file_test.go takes the file below verbatim as the configuration of an adoption.
# SRE Agent configuration for organization "acme".
# Generated by GET /api/v1/config/export?format=hcl. Review it, then run
# terraform init and terraform plan: the plan should import every row and change nothing.
# This file describes the organization at the moment of export and is meant for adopting once.
# Applying it in place of a configuration that already manages these resources deletes whatever
# the file does not list. Read every plan for "0 to destroy".

terraform {
  required_version = ">= 1.12"
  required_providers {
    sreagent = {
      source  = "segfaultpw/sreagent"
      version = ">= 0.3.0"
    }
  }
}

provider "sreagent" {
  organization = "acme"
}

resource "sreagent_security_sla_policy" "security_sla_policy" {
  critical_days = 7
  high_days     = 30
  medium_days   = 90
  low_days      = 180
  info_days     = 0
}

import {
  to = sreagent_security_sla_policy.security_sla_policy
  id = "security_sla_policy"
}

resource "sreagent_security_notification_rule" "critical_and_high_findings" {
  name         = "Critical and high findings"
  enabled      = true
  areas        = []
  min_severity = "high"
  events       = ["new_finding", "sla_breached", "acceptance_expired", "fix_verified"]
  slack        = true
  email        = true
  page         = false
}

import {
  to = sreagent_security_notification_rule.critical_and_high_findings
  id = "00000000-0000-4000-8000-000000000011"
}

resource "sreagent_security_notification_rule" "page_on_critical" {
  name          = "Page on critical"
  enabled       = true
  areas         = ["secrets", "iam"]
  min_severity  = "critical"
  events        = ["new_finding"]
  slack         = true
  slack_channel = "#security-critical"
  email         = false
  page          = true
}

import {
  to = sreagent_security_notification_rule.page_on_critical
  id = "00000000-0000-4000-8000-000000000012"
}

resource "sreagent_security_digest_settings" "security_digest_settings" {
  enabled       = false
  cadence       = "weekly"
  weekday       = 1
  hour          = 9
  slack_channel = ""
  email         = false
}

import {
  to = sreagent_security_digest_settings.security_digest_settings
  id = "security_digest_settings"
}

resource "sreagent_security_code_classes" "security_code_classes" {
  classes = ["other:ssrf", "other:xxe"]
}

import {
  to = sreagent_security_code_classes.security_code_classes
  id = "security_code_classes"
}

resource "sreagent_secret_allow_rule" "acme_web_testdata_aws_access_key" {
  path_glob     = "**/testdata/**"
  reason        = "Vendored test fixtures, not real keys"
  repository    = "acme/web"
  detector_type = "aws_access_key"
  expires_at    = "2020-01-01T00:00:00.000000Z"
}

import {
  to = sreagent_secret_allow_rule.acme_web_testdata_aws_access_key
  id = "00000000-0000-4000-8000-000000000013"
}

resource "sreagent_secret_allow_rule" "all_vendor" {
  path_glob = "vendor/**"
  reason    = "Third party code is scanned upstream"
}

import {
  to = sreagent_secret_allow_rule.all_vendor
  id = "00000000-0000-4000-8000-000000000014"
}

resource "sreagent_secret_allow_rule" "all_vendor_slack_token" {
  path_glob     = "vendor/**"
  reason        = "Vendored test tokens, not real ones"
  detector_type = "slack_token"
}

import {
  to = sreagent_secret_allow_rule.all_vendor_slack_token
  id = "00000000-0000-4000-8000-000000000015"
}
